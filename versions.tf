terraform {
  required_version = ">= 1.9.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }

  # Partial configuration: the storage account details come from
  # backends/backend.hcl (generated by scripts/bootstrap-state.sh) and the
  # state key is passed per environment. See the Makefile and the CI workflows.
  backend "azurerm" {}
}
